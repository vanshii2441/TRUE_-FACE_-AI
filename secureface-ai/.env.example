# TRUE FACE AI — Frontend Environment Variables
# ==============================================
# Copy this file to .env in secureface-ai/ and adjust as needed.

# Backend API Base URL
# - Local single-device testing: http://localhost:8000
# - Multi-device / LAN testing: http://<YOUR_LAN_IP>:8000 (e.g., http://192.168.1.50:8000)
# - Remote / Production: https://api.yourdomain.com
# If left empty, the frontend will automatically connect to window.location.hostname:8000.
VITE_API_BASE_URL=http://localhost:8000
