# TRUE FACE AI — Backend Environment Variables
# =============================================
# Copy this file to .env in backend/ or root directory.
# Replace placeholder values with your real credentials.

# --- App Configuration ---
APP_NAME=TRUE FACE AI
APP_VERSION=0.1.0
DEBUG=false

# --- Security ---
SECRET_KEY=your_secure_random_secret_key_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# --- Server ---
HOST=0.0.0.0
PORT=8000
RATE_LIMIT_PER_MINUTE=120

# --- Face Detection & Quality ---
DETECTION_CONFIDENCE_THRESHOLD=0.90
MAX_IMAGE_SIZE_MB=10.0
MAX_IMAGE_DIMENSION=4096
ENABLE_QUALITY_CHECK=true
BLUR_THRESHOLD=30.0
MIN_FACE_SIZE=40

# --- CORS (Origins permitted to connect to this API) ---
# For multi-device / LAN testing, include your frontend host IP or port:
# Examples:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.50:5173
# Or allow all origins in development:
# CORS_ORIGINS=["*"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# --- Database (MongoDB Atlas or Remote/Local MongoDB) ---
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# IMPORTANT FOR MULTI-DEVICE / CLOUD: Ensure your IP is whitelisted in MongoDB Atlas Network Access.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=TRUE_FACE_AI

# --- Email & OTP Verification ---
# Gmail SMTP requires an App Password (not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_smtp_app_password
EMAILS_FROM_EMAIL=your_email@gmail.com
OTP_EXPIRE_MINUTES=2
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
